@startuml Diagrama_de_Classes_Conceitual_Teste_de_Progresso
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

abstract class UsuarioInstitucional {
  nome
  credencial institucional
  perfil de acesso
}

class Aluno {
  campus acadêmico
  curso
}

class Professor {
  disciplinas sob responsabilidade
  disponibilidade para aplicação
}

class CoordenacaoCurso {
  curso acompanhado
}

class AdministracaoAcademica {
}

class Curso {
  nome
}

class Disciplina {
  nome
  código
}

class Turma {
  código da turma
  semestre
}

class Matricula {
  situação
  semestre letivo
}

class Campus {
  nome
  endereço
}

class Edicao {
  período de inscrição
  período de aplicação
  regra de conversão do bônus
}

class Inscricao {
  data da solicitação
  número de protocolo
  status
}

class AtendimentoEspecial {
  tipo de atendimento
  consentimento específico
}

class ComprovanteInscricao {
  número
  data de emissão
}

class Sala {
  capacidade de prova
  acessível
}

class Alocacao {
  identificação da carteira
}

class EscalaAplicacao {
  função (titular/reserva)
  horário
}

class Presenca {
  situação (presente/ausente)
}

class Bonus {
  valor de zero a um
  status (bloqueado/válido)
}

class LoteDeNotas {
  data de importação
  status do processamento
}

class RegistroDeAuditoria {
  ação realizada
  autor
  data
  valor anterior
  valor novo
  justificativa
}

class Relatorio {
  tipo
  filtros aplicados
  data de geração
}

UsuarioInstitucional <|-- Aluno
UsuarioInstitucional <|-- Professor
UsuarioInstitucional <|-- CoordenacaoCurso
UsuarioInstitucional <|-- AdministracaoAcademica

CoordenacaoCurso "1" --> "0..*" Curso : acompanha
Curso "1" --> "0..*" Disciplina : agrupa
Disciplina "1" --> "0..*" Turma : é ofertada em
Professor "1" --> "0..*" Turma : é responsável por

Aluno "1" --> "0..*" Matricula : possui
Matricula "0..*" --> "1" Turma : refere-se a

Campus "1" --> "0..*" Edicao : sedia
Aluno "1" --> "0..*" Inscricao : realiza
Inscricao "0..*" --> "1" Edicao : refere-se a
Inscricao "1" --> "1" Turma : escolhe como destino do bônus
Inscricao "1" --> "0..1" AtendimentoEspecial : pode solicitar
Inscricao "1" --> "0..1" ComprovanteInscricao : gera
Inscricao "1" --> "0..1" Alocacao : recebe

Sala "1" --> "0..*" Alocacao : recebe
Sala "0..*" --> "1" Campus : localizada em
Sala "1" --> "0..*" EscalaAplicacao : é escalada em
EscalaAplicacao "0..*" --> "1" Professor : escala

Alocacao "1" --> "0..1" Presenca : registra
Presenca "1" --> "0..1" Bonus : condiciona

LoteDeNotas "1" --> "0..*" Bonus : processa
LoteDeNotas "0..*" --> "1" Edicao : pertence a
Bonus "0..*" --> "1" Turma : é direcionado a

AdministracaoAcademica "1" --> "0..*" RegistroDeAuditoria : registra
RegistroDeAuditoria "0..*" --> "0..1" Alocacao : referencia
RegistroDeAuditoria "0..*" --> "0..1" Bonus : referencia

AdministracaoAcademica "1" --> "0..*" Relatorio : gera
CoordenacaoCurso "1" --> "0..*" Relatorio : consulta
Relatorio "0..*" --> "1" Edicao : consolida

note right of Inscricao
  RN01: uma inscrição ativa por aluno e por edição.
  RN02: a turma escolhida deve pertencer
  a uma matrícula vigente do aluno.
end note

note right of Bonus
  RN14: valor sempre entre 0 e 1.
  RN15: aluno ausente não recebe bônus.
end note
@enduml
